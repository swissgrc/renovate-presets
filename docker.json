{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Renovate configuration for all Docker images in this organization",
    "extends": [
      "github>swissgrc/renovate-presets"
    ],
    "regexManagers": [
      {
        "fileMatch": ["(^|/)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
        "matchStrings": [
          "#\\srenovate:\\sdatasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>\\S+))?( versioning=(?<versioning>.*?))?( extractVersion=(?<extractVersion>.*?))?\\s(ENV|ARG) .*?_VERSION(\\s+|=)(?<currentValue>.*)\\s"
        ]
      }
    ]
}
  